{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(cmake *)",
      "Bash(ctest *)",
      "Bash(ninja *)",
      "Bash(mingw32-make *)",
      "Bash(make *)",
      "Bash(g++ *)",
      "Bash(gcc *)",
      "Bash(g++ --version)",
      "Bash(cmake --version)",
      "Bash(ninja --version)",
      "Bash(pkg-config *)",
      "Bash(curl-config *)",
      "Bash(pacman -Q *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(printf *)",
      "Bash(echo *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(build/*)",
      "Bash(./build/*)",
      "Bash(curl -sS https://api.binance.com/*)",
      "Bash(curl -sS https://data-api.binance.vision/*)",
      "Bash(curl -sS https://api1.binance.com/*)",
      "Bash(curl -L -o third_party/nlohmann/json.hpp https://github.com/nlohmann/json/releases/download/v3.11.3/json.hpp)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git remote *)",
      "Bash(git init *)",
      "Bash(gh *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(pacman -S *)",
      "Bash(pacman -R *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
